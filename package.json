{
  "name": "quick-delivery-unified-hub",
  "private": true,
  "version": "5.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "build:customer": "node scripts/build-capacitor-apk.mjs customer",
    "build:rider": "node scripts/build-capacitor-apk.mjs rider",
    "build:admin": "node scripts/build-capacitor-apk.mjs admin",
    "build:all-apks": "node scripts/build-capacitor-apk.mjs all",
    "cap:customer": "node scripts/build-capacitor-apk.mjs customer --sync",
    "cap:rider": "node scripts/build-capacitor-apk.mjs rider --sync",
    "cap:admin": "node scripts/build-capacitor-apk.mjs admin --sync",
    "apk:customer": "node scripts/build-capacitor-apk.mjs customer --sync && gradle :app:assembleDebug -PappRole=customer",
    "apk:rider": "node scripts/build-capacitor-apk.mjs rider --sync && gradle :app:assembleDebug -PappRole=rider",
    "apk:admin": "node scripts/build-capacitor-apk.mjs admin --sync && gradle :app:assembleDebug -PappRole=admin",
    "preview": "vite preview"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/cli": "^6.2.0",
    "@capacitor/core": "^6.2.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "firebase": "^13.1.0",
    "lucide-react": "^0.454.0",
    "postcss": "^8.4.47",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
